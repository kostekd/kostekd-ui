{
	"name": "kostekd-ui-workspace",
	"version": "0.4.0",
	"description": "Nx workspace for kostekd.com.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.19.0",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"dev": "nx run kostekd-ui:dev",
		"start": "nx run kostekd-ui:start",
		"build": "nx run kostekd-ui:build",
		"preview": "nx run kostekd-ui:preview",
		"lint": "nx run kostekd-ui:lint",
		"format": "nx run kostekd-ui:format",
		"format:code": "nx run kostekd-ui --target=format:code",
		"format:imports": "nx run kostekd-ui --target=format:imports",
		"check": "nx run kostekd-ui:check"
	},
	"devDependencies": {
		"nx": "23.2.1"
	}
}
